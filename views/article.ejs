<%- include('partials/site-head') %>
<%- include('partials/site-header') %>
<main>
<section style="padding:100px 0 50px"><div class="narrow">
  <p class="label" style="margin:0 0 26px"><a href="<%= item.type === 'blog' ? '/blog' : '/case-studies' %>" style="color:var(--mute)"><%= item.type === 'blog' ? 'Journal' : 'Case studies' %></a> / <%= item.category %></p>
  <h1 class="disp" style="font-size:clamp(40px,5.5vw,70px);margin:0 0 30px"><%= item.title %></h1>
  <% if (item.date) { %><p class="label"><%= new Date(item.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %></p><% } %>
</div></section>

<% if (item.cover) { %><section style="padding:0 0 10px"><div class="narrow"><img src="<%= item.cover %>" alt="<%= item.title %>" width="1200" height="630" style="display:block;width:100%;height:auto;border-radius:20px;border:1px solid var(--line)"></div></section><% } %>

<style>.prose img{display:block;width:100%;height:auto;margin:44px 0;border-radius:18px;border:1px solid var(--line)}</style>
<section style="padding:20px 0 120px"><div class="narrow prose"><%- item.html %></div></section>

<section style="padding:0 0 130px"><div class="narrow">
  <div style="background:var(--card);border:1px solid var(--line);border-radius:26px;padding:50px">
    <p class="label red" style="margin:0 0 18px">Next step</p>
    <p class="disp" style="font-size:34px;margin:0 0 24px">Want the same kind of analysis for your store?</p>
    <a href="/contact" class="btn btn-red">Get a free analysis →</a>
  </div>
</div></section>
</main>
<%- include('partials/site-footer') %>

<%- include('partials/site-head') %>
<%- include('partials/site-header') %>
<main>
<section style="padding:110px 0 70px"><div class="wrap">
  <p class="label" style="margin:0 0 28px"><span class="red">&#9679;</span>&nbsp; Journal</p>
  <h1 class="disp hero-h" style="font-size:clamp(44px,6.4vw,92px);margin:0 0 30px;max-width:980px">Notes on search and websites, for store owners.</h1>
  <p class="p" style="font-size:20px;max-width:620px">Practical articles on ecommerce SEO, AEO and GEO, and the websites that turn visits into orders.</p>
</div></section>

<style>.jrow{display:grid;grid-template-columns:280px 1fr auto;gap:36px;align-items:center;padding:36px 0;border-top:1px solid var(--line)}.jrow img{display:block;width:100%;height:auto;border-radius:14px;border:1px solid var(--line)}.jread{white-space:nowrap}@media (max-width:760px){.jrow{grid-template-columns:1fr;gap:20px}}</style>
<section style="padding:0 0 120px"><div class="wrap">
  <% if (items.length === 0) { %>
    <p class="p" style="font-size:18px">New articles are on the way.</p>
  <% } %>
  <% items.forEach(function (item) { %>
    <a class="jrow" href="/blog/<%= item.slug %>">
      <% if (item.cover) { %><img src="<%= item.cover %>" alt="" loading="lazy" width="1200" height="630"><% } %>
      <div>
        <p class="label red" style="margin:0 0 10px"><%= item.category %></p>
        <p class="label" style="margin:0 0 14px"><% if (item.date) { %><%= new Date(item.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %><% } %></p>
        <h2 class="disp" style="font-size:clamp(28px,3vw,40px);margin:0 0 14px"><%= item.title %></h2>
        <p class="p" style="font-size:17px;max-width:680px"><%= item.excerpt %></p>
      </div>
      <p class="label red jread" style="margin:0">Read &rarr;</p>
    </a>
  <% }) %>
  <div style="border-top:1px solid var(--line)"></div>
</div></section>

<section style="padding:0 0 130px"><div class="wrap">
  <div style="background:var(--red);color:#fff;border-radius:36px;padding:clamp(60px,8vw,90px) clamp(24px,5vw,60px)">
    <h2 class="disp" style="font-size:clamp(36px,6vw,72px);margin:0 0 24px;max-width:900px">Want this applied to your store?</h2>
    <p style="font-size:19px;line-height:1.55;max-width:560px;margin:0 0 34px;color:#FBE3E0">Book a free call. We'll review your store and come back with a plan before we talk about price.</p>
    <a href="/contact" class="btn" style="background:var(--ink);color:#fff">Book a free call &rarr;</a>
  </div>
</div></section>
</main>
<%- include('partials/site-footer') %>

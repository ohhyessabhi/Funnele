<%- include('partials/site-head') %>
<%- include('partials/site-header') %>
<main>
<section style="padding:110px 0 80px"><div class="wrap">
  <p class="label" style="margin:0 0 28px"><span class="red">&#9679;</span>&nbsp; Journal</p>
  <h1 class="disp hero-h" style="font-size:clamp(44px,6.4vw,92px);margin:0 0 30px;max-width:980px">Notes on search and websites, for store owners.</h1>
  <p class="p" style="font-size:20px;max-width:620px">Practical, specific articles on ecommerce SEO, AEO and GEO, and the websites that turn visits into orders.</p>
</div></section>

<% if (items.length) { const featured = items[0]; const rest = items.slice(1); %>
<section style="padding:0 0 110px"><div class="wrap">
  <a href="/blog/<%= featured.slug %>" class="card reveal" style="display:grid;grid-template-columns:1.3fr 1fr;gap:50px;align-items:center;padding:50px">
    <div>
      <p class="label" style="margin:0 0 20px"><%= featured.category %><% if (featured.date) { %> · <%= new Date(featured.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %><% } %></p>
      <h2 class="disp" style="font-size:clamp(32px,3.6vw,48px);margin:0 0 20px"><%= featured.title %></h2>
      <p class="p" style="font-size:17px"><%= featured.excerpt %></p>
      <p class="label red" style="margin:24px 0 0">Read the article &rarr;</p>
    </div>
    <div style="background:var(--paper);border-radius:22px;padding:40px 30px;text-align:left">
      <p class="label red" style="margin:0 0 14px">Featured</p>
      <p class="disp" style="font-size:30px;margin:0">Start with the question buyers ask.</p>
    </div>
  </a>
</div></section>
<% if (rest.length) { %>
<section style="padding:0 0 110px"><div class="wrap g2" style="display:grid;grid-template-columns:1fr 1fr;gap:24px">
  <% rest.forEach(function (item) { %>
    <a href="/blog/<%= item.slug %>" class="card reveal" style="min-height:260px">
      <p class="label" style="margin:0 0 18px"><%= item.category %></p>
      <h2 class="disp" style="font-size:30px;margin:0 0 14px"><%= item.title %></h2>
      <p class="p" style="font-size:16px"><%= item.excerpt %></p>
    </a>
  <% }) %>
</div></section>
<% } %>
<% } else { %>
<section style="padding:0 0 110px"><div class="wrap"><p class="p">New articles are on the way.</p></div></section>
<% } %>

<section style="padding:0 0 130px"><div class="wrap">
  <p class="label red" style="margin:0 0 20px">Browse by topic</p>
  <h2 class="disp" style="font-size:clamp(36px,4.5vw,58px);margin:0 0 50px;max-width:820px">Read more on the services we offer.</h2>
  <div class="g3" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px"><a href="/seo" class="card reveal" style="min-height:220px"><p class="label" style="margin:0 0 14px">Topic</p><h3 class="disp" style="font-size:28px;margin:0 0 12px">SEO and AEO</h3><p class="p" style="font-size:15px">Search problems, from technical fixes to AI answers.</p></a><a href="/web-development" class="card reveal" style="min-height:220px"><p class="label" style="margin:0 0 14px">Topic</p><h3 class="disp" style="font-size:28px;margin:0 0 12px">Web development</h3><p class="p" style="font-size:15px">Design, development, conversion, speed and upkeep.</p></a><a href="/services" class="card reveal" style="min-height:220px"><p class="label" style="margin:0 0 14px">Topic</p><h3 class="disp" style="font-size:28px;margin:0 0 12px">Services</h3><p class="p" style="font-size:15px">How search and the website work together, and how we start.</p></a></div>
</div></section>
</main>
<%- include('partials/site-footer') %>

e cx="1190" cy="190" r="3" class="cd"/><circle cx="780" cy="260" r="3" class="cd"/><circle cx="900" cy="300" r="3" class="cd"/><circle cx="1040" cy="280" r="5" class="cd hot"/><circle cx="1170" cy="350" r="3" class="cd"/><circle cx="860" cy="430" r="3" class="cd"/><circle cx="990" cy="470" r="3" class="cd"/><circle cx="1120" cy="520" r="5" class="cd hot"/><circle cx="1220" cy="470" r="3" class="cd"/><circle cx="760" cy="560" r="3" class="cd"/><circle cx="930" cy="600" r="3" class="cd"/></svg><div class="wrap split" style="grid-template-columns:1.2fr .8fr;gap:60px;align-items:start">

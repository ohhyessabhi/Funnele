<%- include('../partials/site-head') %>
<%- include('../partials/site-header') %>
<main>
<section style="padding:110px 0 90px"><div class="wrap">
  <p class="label" style="margin:0 0 28px"><span class="red">&#9679;</span>&nbsp; Case studies</p>
  <div class="split" style="grid-template-columns:1.2fr .8fr;gap:60px;align-items:center">
    <div>
      <h1 class="disp hero-h" style="font-size:clamp(44px,6.4vw,92px);margin:0 0 30px">Real stores, measured over six months.</h1>
      <p class="p" style="font-size:20px;max-width:580px;margin:0 0 38px">We don't name clients. Every figure below comes from the store's own analytics and search data.</p>
      <div style="display:flex;gap:14px;flex-wrap:wrap"><a href="/contact" class="btn btn-red">Get a free analysis &rarr;</a></div>
    </div>
    <div style="justify-self:end;width:100%;max-width:520px"><form class="card" style="padding:40px;min-width:0" method="post" action="/contact">
  <p class="disp" style="font-size:30px;margin:0 0 10px">Get your free store analysis</p>
  <p class="p" style="font-size:15px;margin:0 0 26px">See where your store is losing search traffic, on Google and in AI answers. No cost, no obligation.</p>
  <input type="text" name="name" required placeholder="Full name" aria-label="Full name" style="background:#fff;border:1px solid #D8D2C4;border-radius:12px;padding:15px 16px;font:inherit;font-size:16px;color:var(--ink);width:100%;box-sizing:border-box;min-width:0;margin-bottom:12px;display:block">
  <input type="email" name="email" required placeholder="Work email" aria-label="Work email" style="background:#fff;border:1px solid #D8D2C4;border-radius:12px;padding:15px 16px;font:inherit;font-size:16px;color:var(--ink);width:100%;box-sizing:border-box;min-width:0;margin-bottom:12px;display:block">
  <input type="text" name="agency" required placeholder="Store name" aria-label="Store name" style="background:#fff;border:1px solid #D8D2C4;border-radius:12px;padding:15px 16px;font:inherit;font-size:16px;color:var(--ink);width:100%;box-sizing:border-box;min-width:0;margin-bottom:12px;display:block">
  <input type="url" name="website" placeholder="Store website" aria-label="Store website" style="background:#fff;border:1px solid #D8D2C4;border-radius:12px;padding:15px 16px;font:inherit;font-size:16px;color:var(--ink);width:100%;box-sizing:border-box;min-width:0;margin-bottom:12px;display:block">
  <select name="channel" aria-label="What do you want to fix first" style="background:#fff;border:1px solid #D8D2C4;border-radius:12px;padding:15px 16px;font:inherit;font-size:16px;color:var(--ink);width:100%;box-sizing:border-box;min-width:0;margin-bottom:12px;display:block"><option>Choose one</option><option>Technical: Google can't read the store</option><option>Content: articles don't bring buyers</option><option>On-page: product pages don't rank</option><option>Links: too few trusted links</option><option>AI search: not named in AI answers</option><option>Not sure yet</option></select>
  <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0">
  <button type="submit" class="btn btn-red" style="width:100%;justify-content:center;border:0;cursor:pointer;font-family:var(--ff-b);margin-top:8px">Get a free analysis →</button>
  <p class="label" style="margin:16px 0 0;text-align:center">Reply within one working day · No spam</p>
</form></div>
  </div>
</div></section>
<section style="padding:0 0 130px"><div class="wrap">
  <div class="g2" style="display:grid;grid-template-columns:1fr 1fr;gap:28px;align-items:stretch"><a href="/case-studies/golf" class="card reveal" style="display:flex;flex-direction:column;padding:34px">
      <p class="label" style="margin:0 0 14px">Sporting goods · Golf equipment</p>
      <h2 class="disp" style="font-size:34px;margin:0 0 22px">From page three to page one</h2>
      <div style="background:#F6F3EC;border-radius:18px;padding:18px 14px 8px;margin:0 0 26px"><svg viewBox="0 0 400 210" style="width:100%;height:auto;display:block" aria-hidden="true"><line x1="20" y1="180" x2="380" y2="180" stroke="#121212" stroke-width="1"/><text x="24" y="30" font-family="Geist Mono, monospace" font-size="10" fill="#77746C" letter-spacing="1.2">ORGANIC VISITS / MONTH</text><rect x="24" y="149" width="58" height="31" rx="6" fill="#CFCAC0"/><rect x="102" y="96" width="58" height="84" rx="6" fill="#E43525"/><text x="53" y="139" text-anchor="middle" font-family="Geist Mono, monospace" font-size="10" fill="#77746C">~2,000</text><text x="131" y="86" text-anchor="middle" font-family="Geist Mono, monospace" font-size="10" fill="#121212">5,500+</text><text x="53" y="200" text-anchor="middle" font-family="Geist Mono, monospace" font-size="9" fill="#77746C" letter-spacing="1">BEFORE</text><text x="131" y="200" text-anchor="middle" font-family="Geist Mono, monospace" font-size="9" fill="#77746C" letter-spacing="1">AFTER</text><text x="216" y="30" font-family="Geist Mono, monospace" font-size="10" fill="#77746C" letter-spacing="1.2">ORGANIC REVENUE / MONTH</text><rect x="216" y="167" width="58" height="13" rx="6" fill="#CFCAC0"/><rect x="294" y="96" width="58" height="84" rx="6" fill="#E43525"/><text x="245" y="157" text-anchor="middle" font-family="Geist Mono, monospace" font-size="10" fill="#77746C">$2.8K</text><text x="323" y="86" text-anchor="middle" font-family="Geist Mono, monospace" font-size="10" fill="#121212">$18K+</text><text x="245" y="200" text-anchor="middle" font-family="Geist Mono, monospace" font-size="9" fill="#77746C" letter-spacing="1">BEFORE</text><text x="323" y="200" text-anchor="middle" font-family="Geist Mono, monospace" font-size="9" fill="#77746C" letter-spacing="1">AFTER</text></svg></div>
      <p class="p" style="font-size:15px;margin:0 0 12px"><strong style="color:#121212">The problem.</strong> Strong products and reviews, but the site was almost invisible for the searches buyers typed every day.</p>
      <p class="p" style="font-size:15px;margin:0 0 22px"><strong style="color:#121212">What we did.</strong> Rewrote category pages, added buying guides, fixed slow pages and removed toxic backlinks.</p>
      <p class="label" style="margin:auto 0 16px">Top-10 keywords: 8 → 22</p>
      <p class="label red" style="margin:0">Read the case study &rarr;</p>
    </a><a href="/case-studies/industrial" class="card reveal" style="display:flex;flex-direction:column;padding:34px">
      <p class="label" style="margin:0 0 14px">Industrial · Cleaning products</p>
      <h2 class="disp" style="font-size:34px;margin:0 0 22px">From invisible to page one</h2>
      <div style="background:#F6F3EC;border-radius:18px;padding:18px 14px 8px;margin:0 0 26px"><svg viewBox="0 0 400 210" style="width:100%;height:auto;display:block" aria-hidden="true"><line x1="20" y1="180" x2="380" y2="180" stroke="#121212" stroke-width="1"/><text x="24" y="30" font-family="Geist Mono, monospace" font-size="10" fill="#77746C" letter-spacing="1.2">ORGANIC VISITS / MONTH</text><rect x="24" y="156" width="58" height="24" rx="6" fill="#CFCAC0"/><rect x="102" y="96" width="58" height="84" rx="6" fill="#E43525"/><text x="53" y="146" text-anchor="middle" font-family="Geist Mono, monospace" font-size="10" fill="#77746C">~2,000</text><text x="131" y="86" text-anchor="middle" font-family="Geist Mono, monospace" font-size="10" fill="#121212">7,000+</text><text x="53" y="200" text-anchor="middle" font-family="Geist Mono, monospace" font-size="9" fill="#77746C" letter-spacing="1">BEFORE</text><text x="131" y="200" text-anchor="middle" font-family="Geist Mono, monospace" font-size="9" fill="#77746C" letter-spacing="1">AFTER</text><text x="216" y="30" font-family="Geist Mono, monospace" font-size="10" fill="#77746C" letter-spacing="1.2">ORGANIC REVENUE / MONTH</text><rect x="216" y="165" width="58" height="15" rx="6" fill="#CFCAC0"/><rect x="294" y="96" width="58" height="84" rx="6" fill="#E43525"/><text x="245" y="155" text-anchor="middle" font-family="Geist Mono, monospace" font-size="10" fill="#77746C">$4.5K</text><text x="323" y="86" text-anchor="middle" font-family="Geist Mono, monospace" font-size="10" fill="#121212">$25K+</text><text x="245" y="200" text-anchor="middle" font-family="Geist Mono, monospace" font-size="9" fill="#77746C" letter-spacing="1">BEFORE</text><text x="323" y="200" text-anchor="middle" font-family="Geist Mono, monospace" font-size="9" fill="#77746C" letter-spacing="1">AFTER</text></svg></div>
      <p class="p" style="font-size:15px;margin:0 0 12px"><strong style="color:#121212">The problem.</strong> Good products, but most priority keywords did not rank in the first 100 results.</p>
      <p class="p" style="font-size:15px;margin:0 0 22px"><strong style="color:#121212">What we did.</strong> Built category pages for boat, RV and truck cleaning, rewrote product pages, and added content and link building.</p>
      <p class="label" style="margin:auto 0 16px">Top-10 keywords: 1 → 6</p>
      <p class="label red" style="margin:0">Read the case study &rarr;</p>
    </a></div>
</div></section>
<section style="padding:0 0 130px"><div class="wrap">
  <div style="border-top:1px solid var(--line);padding-top:36px;display:grid;grid-template-columns:1fr 1fr;gap:40px">

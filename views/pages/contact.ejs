<%- include('../partials/site-head') %>
<%- include('../partials/site-header') %>
<main>
<% if (submitted) { %><section style="padding:24px 0 0"><div class="wrap"><div style="background:#ECF7EE;border:1px solid #BFE3C8;border-radius:16px;padding:20px 24px;font-size:16px">Thanks. We have your details and will reply within one working day.</div></div></section><% } %>
<% if (error) { %><section style="padding:24px 0 0"><div class="wrap"><div style="background:#FDECEA;border:1px solid #F3B7B0;border-radius:16px;padding:20px 24px;font-size:16px"><%= error %></div></div></section><% } %>

<section style="padding:110px 0 130px"><div class="wrap split" style="grid-template-columns:1fr 1fr;gap:90px;align-items:start">

  <div>
    <p class="label" style="margin:0 0 28px"><span class="red">&#9679;</span>&nbsp; Contact</p>
    <h1 class="disp hero-h" style="font-size:clamp(44px,6vw,84px);margin:0 0 30px">Let's talk about your store.</h1>
    <p class="p" style="font-size:20px;max-width:520px;margin:0 0 56px">A free 30-minute call. We look at where your store stands, then send you a written plan. Price comes after you've seen the plan.</p>

    <div style="display:grid;gap:0">
      <div style="display:grid;grid-template-columns:70px 1fr;gap:20px;padding:28px 0;border-top:1px solid var(--line)">
        <p class="label red" style="margin:0">01</p>
        <div><h3 class="disp" style="font-size:26px;margin:0 0 8px">The call</h3><p class="p" style="font-size:16px">Thirty minutes about your store, your goals and what isn't working.</p></div>
      </div>
      <div style="display:grid;grid-template-columns:70px 1fr;gap:20px;padding:28px 0;border-top:1px solid var(--line)">
        <p class="label red" style="margin:0">02</p>
        <div><h3 class="disp" style="font-size:26px;margin:0 0 8px">The analysis</h3><p class="p" style="font-size:16px">A written review of what's working and what isn't, sent within a week.</p></div>
      </div>
      <div style="display:grid;grid-template-columns:70px 1fr;gap:20px;padding:28px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
        <p class="label red" style="margin:0">03</p>
        <div><h3 class="disp" style="font-size:26px;margin:0 0 8px">The plan and price</h3><p class="p" style="font-size:16px">A proposed plan and a fixed price, agreed with you before any work starts.</p></div>
      </div>
    </div>

    <p class="p" style="font-size:16px;margin:40px 0 0">Prefer email? Write to <a href="mailto:abhijeet@funnele.com" class="red" style="text-decoration:underline">abhijeet@funnele.com</a>.</p>
  </div>

  <form method="post" action="/contact" style="background:#FFFFFF;border:1px solid var(--line);border-radius:26px;padding:44px">
    <div style="position:absolute;left:-9999px" aria-hidden="true"><label>Leave this empty<input type="text" name="company" tabindex="-1" autocomplete="off"></label></div>

    <p class="disp" style="font-size:30px;margin:0 0 28px">Tell us about your store</p>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
      <label style="display:grid;gap:8px;font-size:15px;color:var(--ink2)">Your name
        <input type="text" name="name" required placeholder="Full name" style="border:1px solid #D8D2C4;border-radius:12px;padding:14px 16px;font:inherit;font-size:16px;color:var(--ink);background:#FFFFFF;width:100%;box-sizing:border-box">
      </label>
      <label style="display:grid;gap:8px;font-size:15px;color:var(--ink2)">Work email
        <input type="email" name="email" required placeholder="you@yourstore.com" style="border:1px solid #D8D2C4;border-radius:12px;padding:14px 16px;font:inherit;font-size:16px;color:var(--ink);background:#FFFFFF;width:100%;box-sizing:border-box">
      </label>
      <label style="display:grid;gap:8px;font-size:15px;color:var(--ink2)">Store name
        <input type="text" name="agency" required placeholder="Your store name" style="border:1px solid #D8D2C4;border-radius:12px;padding:14px 16px;font:inherit;font-size:16px;color:var(--ink);background:#FFFFFF;width:100%;box-sizing:border-box">
      </label>
      <label style="display:grid;gap:8px;font-size:15px;color:var(--ink2)">Store website
        <input type="url" name="website" placeholder="https://" style="border:1px solid #D8D2C4;border-radius:12px;padding:14px 16px;font:inherit;font-size:16px;color:var(--ink);background:#FFFFFF;width:100%;box-sizing:border-box">
      </label>
      <label style="display:grid;gap:8px;font-size:15px;color:var(--ink2)">Platform
        <select name="clients" style="border:1px solid #D8D2C4;border-radius:12px;padding:14px 16px;font:inherit;font-size:16px;color:var(--ink);background:#FFFFFF;width:100%;box-sizing:border-box">
          <option>Shopify</option>
          <option>BigCommerce</option>
          <option>WooCommerce</option>
          <option>Magento</option>
          <option>WordPress</option>
          <option>Other or not sure</option>
        </select>
      </label>
      <label style="display:grid;gap:8px;font-size:15px;color:var(--ink2)">What do you need help with?
        <select name="channel" style="border:1px solid #D8D2C4;border-radius:12px;padding:14px 16px;font:inherit;font-size:16px;color:var(--ink);background:#FFFFFF;width:100%;box-sizing:border-box">
          <optgroup label="Search">
            <option>SEO: technical problems</option>
            <option>SEO: content</option>
            <option>SEO: product pages</option>
            <option>SEO: links</option>
            <option>AEO and GEO (AI search)</option>
          </optgroup>
          <optgroup label="Website">
            <option>Web: design</option>
            <option>Web: development</option>
            <option>Web: conversion</option>
            <option>Web: speed</option>
            <option>Web: upkeep</option>
          </optgroup>
          <option>Not sure yet</option>
        </select>
      </label>
    </div>

    <label style="display:grid;gap:8px;font-size:15px;color:var(--ink2);margin:16px 0 0">Anything else we should know? <span style="color:var(--mute)">(optional)</span>
      <textarea name="message" rows="4" placeholder="A sentence or two is plenty." style="border:1px solid #D8D2C4;border-radius:12px;padding:14px 16px;font:inherit;font-size:16px;color:var(--ink);background:#FFFFFF;width:100%;box-sizing:border-box;resize:vertical"></textarea>
    </label>

    <button type="submit" class="btn btn-red" style="width:100%;justify-content:center;border:0;cursor:pointer;margin-top:26px">Get a free analysis &rarr;</button>
    <p class="p" style="font-size:14px;color:var(--mute);text-align:center;margin:16px 0 0">We reply within one working day. We don't share your details.</p>
  </form>

</div></section>
</main>
<%- include('../partials/site-footer') %>

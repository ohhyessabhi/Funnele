<%- include('../partials/site-head') %>
<%- include('../partials/site-header') %>
<main>
<section style="padding:110px 0 90px"><div class="wrap">
  <p class="label" style="margin:0 0 28px"><span class="red">&#9679;</span>&nbsp; Web development / Conversion</p>
  <div class="split" style="grid-template-columns:1.2fr .8fr;gap:60px;align-items:center">
    <div>
      <h1 class="disp hero-h" style="font-size:clamp(44px,6.4vw,92px);margin:0 0 30px">Turn more visitors into buyers, without buying more traffic.</h1>
      <p class="p" style="font-size:20px;max-width:580px;margin:0 0 38px">Conversion work is measured. We look at where shoppers leave, change one thing at a time, and keep only what makes a measurable difference.</p>
      <div style="display:flex;gap:14px;flex-wrap:wrap"><a href="/contact" class="btn btn-red">Book a free strategy call &rarr;</a></div>
    </div>
    <div style="justify-self:end;width:100%;max-width:520px"><form class="card" style="padding:40px;min-width:0" method="post" action="/contact">
  <p class="disp" style="font-size:30px;margin:0 0 10px">Get your free store analysis</p>
  <p class="p" style="font-size:15px;margin:0 0 26px">See where your store is losing search traffic, on Google and in AI answers. No cost, no obligation.</p>
  <input type="text" name="name" required placeholder="Full name" aria-label="Full name" style="background:#fff;border:1px solid #D8D2C4;border-radius:12px;padding:15px 16px;font:inherit;font-size:16px;color:var(--ink);width:100%;box-sizing:border-box;min-width:0;margin-bottom:12px;display:block">
  <input type="email" name="email" required placeholder="Work email" aria-label="Work email" style="background:#fff;border:1px solid #D8D2C4;border-radius:12px;padding:15px 16px;font:inherit;font-size:16px;color:var(--ink);width:100%;box-sizing:border-box;min-width:0;margin-bottom:12px;display:block">
  <input type="text" name="agency" required placeholder="Store name" aria-label="Store name" style="background:#fff;border:1px solid #D8D2C4;border-radius:12px;padding:15px 16px;font:inherit;font-size:16px;color:var(--ink);width:100%;box-sizing:border-box;min-width:0;margin-bottom:12px;display:block">
  <input type="url" name="website" placeholder="Store website" aria-label="Store website" style="background:#fff;border:1px solid #D8D2C4;border-radius:12px;padding:15px 16px;font:inherit;font-size:16px;color:var(--ink);width:100%;box-sizing:border-box;min-width:0;margin-bottom:12px;display:block">
  <select name="channel" aria-label="What do you want to fix first" style="background:#fff;border:1px solid #D8D2C4;border-radius:12px;padding:15px 16px;font:inherit;font-size:16px;color:var(--ink);width:100%;box-sizing:border-box;min-width:0;margin-bottom:12px;display:block"><option>What do you want to fix first?</option><option>Technical: Google can't read the store</option><option>Content: articles don't bring buyers</option><option>On-page: product pages don't rank</option><option>Links: too few trusted links</option><option>AI search: not named in AI answers</option><option>Not sure yet</option></select>
  <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0">
  <button type="submit" class="btn btn-red" style="width:100%;justify-content:center;border:0;cursor:pointer;font-family:var(--ff-b);margin-top:8px">Request my free analysis →</button>
  <p class="label" style="margin:16px 0 0;text-align:center">Reply within one working day · No spam</p>
</form></div>
  </div>
</div></section>
<section style="padding:0 0 130px"><div class="wrap split" style="gap:80px">
  <div><p class="label red" style="margin:0 0 20px">Does this sound like you?</p><h2 class="disp" style="font-size:clamp(36px,4.5vw,58px);margin:0">Signs it's time to work on the website.</h2></div>
  <div><div style="display:flex;gap:18px;padding:22px 0;border-top:1px solid var(--line)"><span class="red label" style="min-width:34px">01</span><p class="p" style="font-size:18px;color:var(--ink)">People view products but leave without adding to cart.</p></div><div style="display:flex;gap:18px;padding:22px 0;border-top:1px solid var(--line)"><span class="red label" style="min-width:34px">02</span><p class="p" style="font-size:18px;color:var(--ink)">Checkout has more steps than it needs.</p></div><div style="display:flex;gap:18px;padding:22px 0;border-top:1px solid var(--line)"><span class="red label" style="min-width:34px">03</span><p class="p" style="font-size:18px;color:var(--ink)">Mobile visitors drop off before they reach the basket.</p></div><div style="display:flex;gap:18px;padding:22px 0;border-top:1px solid var(--line)"><span class="red label" style="min-width:34px">04</span><p class="p" style="font-size:18px;color:var(--ink)">Nobody knows which changes help, because nothing is measured.</p></div></div>
</div></section>
<section style="padding:0 0 130px"><div class="wrap">
  <p class="label red" style="margin:0 0 20px">How we work</p>
  <h2 class="disp" style="font-size:clamp(36px,4.5vw,58px);margin:0 0 56px;max-width:820px">Review, plan, then price. In that order.</h2>
  <div class="g3"><div class="card reveal" style="min-height:240px"><p class="label" style="margin:0 0 14px">Step 01</p><h3 class="disp" style="font-size:28px;margin:0 0 12px">Measure</h3><p class="p" style="font-size:15px">We map where shoppers leave, on desktop and mobile, before changing anything.</p></div><div class="card reveal" style="min-height:240px"><p class="label" style="margin:0 0 14px">Step 02</p><h3 class="disp" style="font-size:28px;margin:0 0 12px">Change</h3><p class="p" style="font-size:15px">One change at a time, on product, cart and checkout pages.</p></div><div class="card reveal" style="min-height:240px"><p class="label" style="margin:0 0 14px">Step 03</p><h3 class="disp" style="font-size:28px;margin:0 0 12px">Keep</h3><p class="p" style="font-size:15px">What works stays. What doesn't is reversed, and the reason is written down.</p></div></div>
</div></section>
<section style="padding:0 0 130px"><div class="narrow">
  <div style="background:var(--card);border:1px solid var(--line);border-radius:26px;padding:50px">
    <p class="label red" style="margin:0 0 18px">What changes</p>
    <p class="p" style="font-size:20px;color:var(--ink);margin:0 0 18px">Decisions based on measured changes, not guesses, so each improvement is one you can keep.</p>
    <a href="/web-development" class="label red">See how we work &rarr;</a>
  </div>
</div></section>
<section style="padding:0 0 130px"><div class="wrap">
  <div style="background:var(--red);color:#fff;border-radius:36px;padding:clamp(60px,8vw,100px) clamp(24px,5vw,60px)">
    <h2 class="disp" style="font-size:clamp(40px,7vw,88px);margin:0 0 26px;max-width:900px">Not sure what your site needs?</h2>
    <p style="font-size:19px;line-height:1.55;max-width:560px;margin:0 0 36px;color:#FBE3E0">Tell us what isn't working. On a 30-minute call we'll review the site and agree a plan before anything is priced.</p>
    <a href="/contact" class="btn" style="background:var(--ink);color:#fff">Book a free strategy call &rarr;</a>
  </div>
</div></section>
</main>
<%- include('../partials/site-footer') %>

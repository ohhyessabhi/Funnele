<section style="padding:110px 0 90px"><div class="wrap">
  <p class="label" style="margin:0 0 28px"><span class="red">&#9679;</span>&nbsp; Web development / Development</p>
  <div class="split" style="grid-template-columns:1.2fr .8fr;gap:60px;align-items:center">
    <div>
      <h1 class="disp hero-h" style="font-size:clamp(44px,6.4vw,92px);margin:0 0 30px">Shopify developer and platform builds that are stable and easy to change.</h1>
      <p class="p" style="font-size:20px;max-width:580px;margin:0 0 38px">Shopify, BigCommerce, WooCommerce, Magento or WordPress. We build and change the site so it is stable, easy to update and connected to the tools you already use.</p>
      <div style="display:flex;gap:14px;flex-wrap:wrap"><a href="/contact" class="btn btn-red">Get a free analysis &rarr;</a></div>
    </div>
    <div style="justify-self:end;width:100%;max-width:520px"><form class="card" style="padding:40px;min-width:0" method="post" action="/contact">
  <p class="disp" style="font-size:30px;margin:0 0 10px">Get your free store analysis</p>
